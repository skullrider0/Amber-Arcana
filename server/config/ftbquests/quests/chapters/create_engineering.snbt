    {
      "id": "49A0DF8BF8B13288",
      "title": "A processing line",
      "icon": "create:belt_connector",
      "shape": "hexagon",
      "size": 1.15d,
      "x": 3.0d,
      "y": 0.0d,
      "description": [
        "Connect a belt-fed line that performs at least two operations: washing, pressing, mixing, compacting, or bulk smelting.",
        "",
        "Place an input chest and an output buffer. Add funnels or filters so unfinished materials cannot loop back into the wrong machine.",
        "",
        "Run a full stack through the line, then tick the checkmark."
      ],
