    {
      "id": "6A19120000000401",
      "title": "Steam under control",
      "icon": "create:steam_engine",
      "shape": "hexagon",
      "size": 1.15,
      "x": 6.0,
      "y": 3.0,
      "description": [
        "Build a small Steam Engine installation with a dependable water supply. Keep heat sources accessible and protect nearby wood, animals, and colony buildings.",
        "",
        "Add a clutch, gearshift, or another deliberate shutdown control before connecting the engine to your main network.",
        "",
        "Run it under load and confirm the water supply remains stable.",
        "",
