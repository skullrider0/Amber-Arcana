    {
      "id": "42BD2E092F753492",
      "title": "Rails and schedules",
      "icon": "create:track_station",
      "shape": "hexagon",
      "size": 1.15d,
      "x": 3.0d,
      "y": 3.0d,
      "description": [
        "Build a railway between your base and a useful outpost. Place stations at both ends and give the train a working schedule.",
        "",
        "Use Steam 'n' Rails where it improves the route, but test signals and junctions with an empty train before carrying players or valuable cargo.",
        "",
        "Complete one automatic round trip, then tick the checkmark."
      ],
