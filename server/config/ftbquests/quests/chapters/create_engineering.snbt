    {
      "id": "2B415B8CDDC3ACFF",
      "title": "Precision mechanisms",
      "icon": "create:precision_mechanism",
      "shape": "hexagon",
      "size": 1.15d,
      "x": 6.0d,
      "y": 0.0d,
      "description": [
        "Build a sequenced assembly line for Precision Mechanisms and power a Deployer from the same workshop.",
        "",
        "Use REI to confirm every assembly step. Give the incomplete mechanism a return path, but stop the belt when its output storage is full.",
        "",
        "Successfully produce several mechanisms before claiming the reward."
      ],
